---
layout: null
sitemap:
  exclude: 'yes'
---
[
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "title-lower"    : "{{ post.title | escape | downcase}}",
      "categories" : "{{ post.categories }}",
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]